<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- Android 12+ mascara o animated icon. Usar o símbolo dedicado com
             margem interna evita o recorte que ocorria ao reutilizar a logo
             horizontal do launcher. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/apois_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
