# Browser-exposed Vite configuration. These values are public to the shipped frontend.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_APOIS_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_MAPS_KEY

# Do not put service_role keys, private keys, access tokens, client secrets,
# payment-provider credentials, or any other privileged credential in VITE_* variables.
