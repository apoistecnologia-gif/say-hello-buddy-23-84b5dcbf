# Supabase public client configuration
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Browser/mobile public configuration
VITE_APOIS_API_URL="https://your-project-ref.supabase.co/functions/v1"
VITE_GOOGLE_MAPS_API_KEY="your-browser-maps-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Server-only Woovi configuration (Supabase Edge Function secrets).
# Production: https://api.woovi.com
# Sandbox:    https://api.woovi-sandbox.com
WOOVI_APP_ID="server-only-app-id"
WOOVI_API_BASE_URL="https://api.woovi.com"
WOOVI_WEBHOOK_AUTHORIZATION="server-only-random-webhook-secret"
WOOVI_RIDE_PIX_EXPIRES_SECONDS="900"

# Pix processing fee is a versioned financial contract, not an environment-only
# toggle. Keep the TypeScript estimator and the authoritative PostgreSQL fee
# function in the same release whenever the contracted provider tariff changes.

# Never place service-role keys, sb_secret_ keys, Woovi AppIDs, gateway secrets,
# webhook tokens, Firebase private credentials, or other server-side secrets in
# VITE_* variables or commit real values to the repository.
