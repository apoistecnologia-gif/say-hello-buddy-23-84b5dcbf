# Supabase public client configuration
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Browser/mobile public configuration
VITE_APOIS_API_URL="https://your-project-ref.supabase.co/functions/v1"
VITE_GOOGLE_MAPS_API_KEY="your-browser-maps-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Never place service-role keys, sb_secret_ keys, gateway secrets, webhook tokens,
# Firebase private credentials, or other server-side secrets in VITE_* variables.
